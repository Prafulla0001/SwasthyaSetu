# ── MongoDB (kept for patient case-taking data) ───────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/casecare_db

# ── Session ───────────────────────────────────────────────────────────────
SESSION_SECRET=swasthyasetu-sih2026-secret-change-in-prod

# ── Firebase Admin SDK (Server-side) ─────────────────────────────────────
# Get from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Firebase Client SDK (Browser-side, shown in EJS views) ───────────────
# Get from: Firebase Console → Project Settings → General → Your Apps → Web App config
FIREBASE_API_KEY=AIzaSy-your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ── Cloudinary ────────────────────────────────────────────────────────────
# Get from: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── Google Gemini AI ──────────────────────────────────────────────────────
# Get from: aistudio.google.com → Get API Key (free)
GEMINI_API_KEY=AIzaSy-your-gemini-api-key

# ── Google Cloud Vision (OCR) ─────────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials → Create API Key
# Enable: "Cloud Vision API" in the project
GOOGLE_CLOUD_VISION_KEY=AIzaSy-your-vision-api-key

# ── App ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
