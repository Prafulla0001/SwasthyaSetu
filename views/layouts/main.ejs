<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %> | MediKiosk
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="d-flex flex-column min-vh-100">

  <!-- TOP BAR -->
  <div class="top-bar bg-dark text-white py-1">
    <div class="container d-flex justify-content-between align-items-center">
      <small><i class="bi bi-shield-check me-1"></i> MediKiosk</small>
      <small class="d-flex align-items-center">
        <div id="google_translate_element" class="me-3"></div>
        <span><i class="bi bi-lock me-1"></i> ABDM Compliant</span>
      </small>
    </div>
  </div>

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-medical sticky-top">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center" href="/">
        <div class="brand-icon me-2">
          <i class="bi bi-heart-pulse-fill"></i>
        </div>
        <div class="brand-text">
          <span class="brand-title">MediKiosk</span>
          <small class="brand-tagline d-block">Ai Smart Clinic Intake Before Consultaion</small>
        </div>
      </a>

      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item">
            <a class="nav-link <%= title === 'CASECARE AI' ? 'active' : '' %>" href="/">
              <i class="bi bi-house-door me-1"></i>Home
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= title === 'New Patient Registration' ? 'active' : '' %>" href="/patients/new">
              <i class="bi bi-person-plus me-1"></i>New Case
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= title === 'All Patients' ? 'active' : '' %>" href="/patients">
              <i class="bi bi-people me-1"></i>Patients
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= title === 'Doctor Dashboard' ? 'active' : '' %>" href="/dashboard">
              <i class="bi bi-speedometer2 me-1"></i>Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link position-relative <%= title === 'Red Flag Alerts' ? 'active' : '' %>"
              href="/dashboard/alerts">
              <i class="bi bi-exclamation-triangle me-1"></i>Alerts
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                id="alertBadge" style="font-size: 0.6rem;">
                !
              </span>
            </a>
          </li>
          <li class="nav-item ms-lg-2">
            <a href="/patients/new" class="btn btn-accent btn-sm">
              <i class="bi bi-plus-lg me-1"></i>Quick Case
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- MAIN CONTENT -->
  <main class="flex-grow-1 py-4">
    <div class="container">
      <%- body %>
    </div>
  </main>

  <!-- FOOTER -->
  <footer class="footer-medical mt-auto">
    <div class="footer-top py-4">
      <div class="container">
        <div class="row g-4">
          <!-- Brand -->
          <div class="col-lg-4 col-md-6">
            <div class="d-flex align-items-center mb-3">
              <div
                class="brand-icon me-2 bg-white text-medical rounded-circle d-flex align-items-center justify-content-center"
                style="width:40px;height:40px;">
                <i class="bi bi-heart-pulse-fill"></i>
              </div>
              <div>
                <h5 class="mb-0 text-white">HealthTech AI</h5>
                <small class="text-light opacity-75">SIH26047</small>
              </div>
            </div>
            <p class="text-light opacity-75 small mb-3">
              AI-powered patient case-taking software integrating Ayurvedic assessment,
              document OCR, and intelligent clinical summaries for better healthcare delivery.
            </p>
            <div class="d-flex gap-2">
              <span class="badge bg-light text-medical"><i class="bi bi-shield-check me-1"></i>HIPAA Ready</span>
              <span class="badge bg-ayurveda text-dark"><i class="bi bi-leaf me-1"></i>Ayurveda</span>
            </div>
          </div>

          <!-- Quick Links -->
          <div class="col-lg-2 col-md-6">
            <h6 class="text-white mb-3">Platform</h6>
            <ul class="list-unstyled footer-links">
              <li><a href="/patients/new"><i class="bi bi-chevron-right small"></i> New Case</a></li>
              <li><a href="/patients"><i class="bi bi-chevron-right small"></i> Patients</a></li>
              <li><a href="/dashboard"><i class="bi bi-chevron-right small"></i> Dashboard</a></li>
              <li><a href="/dashboard/records"><i class="bi bi-chevron-right small"></i> Records</a></li>
            </ul>
          </div>

          <!-- Features -->
          <div class="col-lg-3 col-md-6">
            <h6 class="text-white mb-3">Key Features</h6>
            <ul class="list-unstyled footer-links">
              <li><a href="#"><i class="bi bi-chevron-right small"></i> AI Chat Case Taking</a></li>
              <li><a href="#"><i class="bi bi-chevron-right small"></i> Document OCR & Auto-Fill</a></li>
              <li><a href="#"><i class="bi bi-chevron-right small"></i> Red-Flag Detection</a></li>
              <li><a href="#"><i class="bi bi-chevron-right small"></i> ABDM / HIS Integration</a></li>
            </ul>
          </div>

          <!-- Team & Event -->
          <div class="col-lg-3 col-md-6">
            <h6 class="text-white mb-3">&copy;MediKiosk</h6>
            <div class="text-light opacity-75 small">
              <p class="mb-1"><strong>Team:</strong> SwasthyaSetu</p>
              <p class="mb-1"><strong>Theme:</strong> HealthTech</p>
              <p class="mb-2"><strong>Category:</strong> Software</p>
              <div class="mt-3">
                <span class="badge bg-warning text-dark me-1">&copy;MediKiosk Private Limited</span>
                <span class="badge bg-info text-dark">Privacy</span>
                <span class="badge bg-info text-dark">Terms</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom py-3">
      <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
        <small class="text-light opacity-75">
          &copy;Ministry of Ayush,All India Institute of Ayurveda
        </small>
        <small class="text-light opacity-75 mt-2 mt-md-0">
          <i class="bi bi-shield-lock me-1"></i> Secure & Compliant |
          <i class="bi bi-globe me-1"></i> Multilingual Support |
          <i class="bi bi-hdd-network me-1"></i> ABDM Ready
        </small>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>

  <!-- Google Translate Widget -->
  <script type="text/javascript">
    function googleTranslateElementInit() {
      new google.translate.TranslateElement({
        pageLanguage: 'en',
        includedLanguages: 'en,hi,bn,te,mr,ta,ur,gu,kn,ml,pa,or,as', // English + major Indian regional languages
        layout: google.translate.TranslateElement.InlineLayout.SIMPLE
      }, 'google_translate_element');
    }
  </script>
  <script type="text/javascript"
    src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
</body>

</html>