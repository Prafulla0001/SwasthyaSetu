<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card border-0 shadow" style="border-radius:20px;overflow:hidden">
      <div class="card-header py-4 text-center text-white" style="background:linear-gradient(135deg,#03256c,#0d7377)">
        <div style="font-size:4rem">✅</div>
        <h4 class="fw-bold mt-2">Appointment Booked!</h4>
        <p class="opacity-75 mb-0">Your appointment has been submitted for confirmation.</p>
      </div>
      <div class="card-body p-4">

        <div class="row g-3 mb-4">
          <div class="col-sm-6">
            <div class="bg-light rounded p-3">
              <div class="text-muted small">Appointment ID</div>
              <div class="fw-bold text-primary">#<%= appointment.id.slice(-8).toUpperCase() %></div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="bg-light rounded p-3">
              <div class="text-muted small">Status</div>
              <span class="badge bg-warning text-dark fw-semibold"><%= appointment.status %></span>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="bg-light rounded p-3">
              <div class="text-muted small">Type</div>
              <div class="fw-semibold"><%= appointment.appointmentType %></div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="bg-light rounded p-3">
              <div class="text-muted small">Scheduled</div>
              <div class="fw-semibold"><%= appointment.scheduledAt ? new Date(appointment.scheduledAt).toLocaleString('en-IN') : 'To be confirmed' %></div>
            </div>
          </div>
        </div>

        <% if (appointment.ocrSummary && appointment.ocrSummary.length > 0) { %>
          <h6 class="fw-bold mb-3"><i class="bi bi-text-paragraph me-2 text-primary"></i>OCR Results</h6>
          <% appointment.ocrSummary.forEach(ocr => { %>
            <div class="card border-0 bg-light mb-3" style="border-radius:12px">
              <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="fw-semibold small"><i class="bi bi-file-earmark me-1"></i><%= ocr.filename %></span>
                  <span class="badge bg-info-subtle text-info small"><%= ocr.documentType %></span>
                </div>
                <% if (ocr.ocrText && !ocr.ocrText.startsWith('OCR Error')) { %>
                  <% const keyData = Object.entries(ocr.keyFindings || {}).filter(([k,v]) => k !== 'documentType' && v); %>
                  <% if (keyData.length > 0) { %>
                    <div class="row g-1">
                      <% keyData.slice(0,6).forEach(([k,v]) => { %>
                        <div class="col-6">
                          <div class="d-flex justify-content-between" style="font-size:.78rem">
                            <span class="text-muted text-capitalize"><%= k.replace(/([A-Z])/g,' $1').trim() %>:</span>
                            <span class="fw-semibold"><%= v %></span>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <pre class="small text-muted mb-0" style="white-space:pre-wrap;font-family:inherit;max-height:80px;overflow:hidden"><%= ocr.ocrText.slice(0,300) %></pre>
                  <% } %>
                <% } else { %>
                  <p class="text-muted small mb-0">OCR could not extract structured data from this file.</p>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } %>

        <div class="d-flex gap-2 mt-3">
          <a href="/appointments" class="btn btn-outline-primary flex-fill">
            <i class="bi bi-calendar me-1"></i>My Appointments
          </a>
          <a href="/reports" class="btn btn-outline-secondary flex-fill">
            <i class="bi bi-folder me-1"></i>My Reports
          </a>
          <a href="/" class="btn btn-primary flex-fill">
            <i class="bi bi-house me-1"></i>Home
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
